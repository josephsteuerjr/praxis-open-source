# Praxis — минимальный .env для бандла. Скопируй в .env и заполни.
# Полный список рычагов (80 переменных) — в .env.example; здесь только то,
# без чего она не поднимется или не поймёт, чей она компаньон.

# --- Telegram: она входит как ПОЛЬЗОВАТЕЛЬ, а не как бот -----------------------
# api_id / api_hash берутся на https://my.telegram.org → API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
# Если на аккаунте включён облачный пароль (2FA) — впиши его, вход спросит сам.
TELEGRAM_2FA=
# Имя файла сессии; ляжет рядом с кодом как praxis.session и переживёт пересборку.
TELEGRAM_SESSION=praxis
# Пусто = она отвечает везде, куда её позвали. Список id через запятую сужает.
TELEGRAM_ALLOWED_CHATS=

# --- Кто хозяин ----------------------------------------------------------------
# Твой numeric id в Telegram (спроси у @userinfobot). От него зависят её права.
PRAXIS_OWNER_ID=
SPEAKER=

# --- Мозг: вариант A, ключ провайдера (проще) ----------------------------------
# Читается ОДИН раз при первом старте и переносится в memory/llm.json; дальше
# модель меняется в пульте, а не здесь.
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/anthropic
GLM_VOICE_MODEL=glm-5.2

# --- Мозг: вариант B, через relay (профиль relay) -------------------------------
# Ходит в твою подписку ChatGPT/Codex. Раскомментируй, подними профиль relay,
# затем в пульте «Мозг» переключи нужные роли на framework=openai и выбери модель.
# Одних OPENAI_* недостаточно: первый старт по умолчанию создаёт GLM/Anthropic-роли.
# OPENAI_BASE_URL=http://relay:5012
# OPENAI_API_KEY=auto

# --- Быт -----------------------------------------------------------------------
PRAXIS_TZ=UTC
# 0 — память работает на full-text без Ollama (профиль ollama не нужен).
PRAXIS_EMBEDDINGS=0
# cache_control на статике промпта; 0 — фолбэк обычной строкой.
PRAXIS_PROMPT_CACHE=1
# Присутствие, а не рефлекс: пауза перед проходом и минимальный интервал.
PRAXIS_DEBOUNCE_SEC=4
PRAXIS_COOLDOWN_DM=8
PRAXIS_COOLDOWN_GROUP=180

# ⚠ PRAXIS_TEST здесь быть НЕ должно: под ним база уезжает в одноразовый каталог,
# и она поднимется без памяти. Boot-гард специально падает на этой переменной.
