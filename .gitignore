# Durable runtime evidence and generated navigation views are private data,
# never source snapshots. Markdown/JSONL inside runs remain canonical at runtime.
memory/runs/
memory/maps/
memory/self/
memory/desires/
# Canonical lived memory is private runtime data (backed up with memory/, never source code).
memory/life/
# Admitted-group transcripts and their generated topic/participant maps are private
# runtime memory.  They are backed up with memory/, never published in source mirrors.
memory/groups/
# Private machine evidence/cards are indexed at runtime, never source code.
memory/computer/
memory/absence.json
