# Private one-way migrations keep exact retired bytes here.  They are runtime
# provenance, not publishable source or automatic orientation.
memory/.archive/
soul/self.md
soul/self/
soul/reflexes.md
soul/rails.md
# Personality/history snapshots are private runtime provenance.  Source history
# already preserves previous public bytes; do not duplicate them as living docs.
soul/archive/

# Компилируемый пол рук — артефакты сборки, не исходники.
hands/target/
body/target/
body/state/
body/body.json
body/service-body.json
body/system-router.json
# Публичный снапшот relay (в проде этого каталога нет): сборка и логи — не исходник.
relay/target/
relay/logs/
relay/*.log
relay/src.bak-*/
bin/
.build/

# Файл-сигналы рестарта сервисов. В git им нельзя: bootguard-откат
# (git reset --hard) воскресил бы флаг со свежим mtime и увёл сервис в перезапуск.
memory/.restart_*

# Кэш длительностей модулей для praxis_test_parallel: локальная мера этой машины,
# в репозитории ей делать нечего — на другом железе она просто врёт.
.praxis_test_durations.json

# Черновики и планировочные записки в корне не живут: AGENTS.md разрешает шесть доков.
CLAUDE_CODE_INTERMEDIATE_PASS.md
