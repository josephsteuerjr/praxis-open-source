#!/usr/bin/env python3
"""serverdctl — root-CLI для Егора над praxis-serverd (вне её досягаемости).

  serverdctl status              — жив ли broker v2, сокет, operations и audit chain
  serverdctl audit [N]           — последние N строк аудита (что делала Праксис на хосте)
  serverdctl verify-audit        — проверить legacy anchor + всю hash-chain
  serverdctl export-audit        — сделать content-addressed pull-ready snapshot
  serverdctl operations          — persistent root operation handles
  serverdctl recovery            — armed/confirmed/rolled-back receipts
  serverdctl advisor             — что скрывается от утечки + о чём советник шепчет (легибельно)
  serverdctl rotate-token        — сменить токен (потом recreate контейнера praxis)

Это НЕ гейт на её работу — это глаза и рычаги Егора над исполнителем: аудит, ротация,
(позже) apply-update демона. Живёт в /usr/local/bin (deadman защищает от структурной правки).
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

HOME = Path("/opt/praxis-serverd")
STATE = HOME / "state"
RUN = HOME / "run"


def _status() -> int:
    active = subprocess.run(["systemctl", "is-active", "praxis-serverd"],
                            capture_output=True, text=True).stdout.strip()
    print(f"praxis-serverd: {active}")
    print(f"сокет: {'есть' if (RUN/'serverd.sock').exists() else 'НЕТ'}")
    print(f"токен: {'есть' if (RUN/'token').is_file() else 'НЕТ'}")
    audit = STATE / "audit.jsonl"
    n = 0
    try:
        n = sum(1 for _ in audit.open("r", encoding="utf-8"))
    except OSError:
        pass
    print(f"строк аудита: {n}")
    operations = STATE / "operations"
    print(f"operations: {len(list(operations.glob('*/meta.json'))) if operations.is_dir() else 0}")
    try:
        sys.path.insert(0, str(HOME / "lib"))
        import auditlog
        verdict = auditlog.AuditLog(audit).verify()
        print(f"audit chain: {'OK' if verdict.get('ok') else 'BROKEN'} {verdict}")
    except Exception as exc:
        print(f"audit chain: ERROR {type(exc).__name__}: {exc}")
    return 0


def _audit(n: int) -> int:
    audit = STATE / "audit.jsonl"
    try:
        lines = audit.read_text(encoding="utf-8", errors="replace").splitlines()[-n:]
    except OSError:
        print("аудита пока нет")
        return 0
    for ln in lines:
        try:
            r = json.loads(ln)
            print(f"  {r.get('at')} [{r.get('status')}] {r.get('verb')} task={r.get('task') or '-'} "
                  f"peer={r.get('peer_cgroup') or '?'} {('DEADMAN' if r.get('deadman') else '')}")
        except ValueError:
            print("  " + ln[:200])
    return 0


def _advisor() -> int:
    sys.path.insert(0, str(HOME / "lib"))
    import advisor  # noqa: E402
    m = advisor.manifest()
    print("Жёстко закрыты только чужие рабочие проекты:")
    for p in m["protected_roots"]:
        print(f"  {p}")
    print("gitignore:", m["gitignored"])
    print("Советник шепчет о правке:", ", ".join(m["advice_paths"]))
    print("Политика:", m["policy"])
    return 0


def _rotate() -> int:
    import base64
    tok = base64.b64encode(os.urandom(32)).decode()
    (RUN / "token").write_text(tok, encoding="utf-8")
    subprocess.run(["chown", "root:praxis", str(RUN / "token")])
    subprocess.run(["chmod", "0640", str(RUN / "token")])
    print("токен сменён. Теперь: docker compose ... up -d --force-recreate praxis (перечитать токен).")
    return 0


def _operations() -> int:
    operations = STATE / "operations"
    if not operations.is_dir():
        print("operations нет")
        return 0
    sys.path.insert(0, str(HOME / "lib"))
    import hostproc  # noqa: E402
    for directory in sorted(operations.iterdir()):
        if not directory.is_dir():
            continue
        try:
            d = json.loads((directory / "meta.json").read_text(encoding="utf-8"))
            state = hostproc.poll(directory)
            print(f"  {directory.name} [{state.get('status')}] {d.get('name') or d.get('command')} · {d.get('cwd')}")
        except (OSError, ValueError):
            pass
    return 0


def _verify_audit(export: bool = False) -> int:
    sys.path.insert(0, str(HOME / "lib"))
    import auditlog  # noqa: E402
    log = auditlog.AuditLog(STATE / "audit.jsonl")
    result = log.export(STATE / "audit-exports") if export else log.verify()
    print(json.dumps(result, ensure_ascii=False, indent=2))
    return 0 if result.get("ok") else 2


def _recovery() -> int:
    sys.path.insert(0, str(HOME / "lib"))
    import hostrecovery  # noqa: E402
    hostrecovery.configure(STATE)
    print(json.dumps(hostrecovery.status(), ensure_ascii=False, indent=2))
    return 0


def main(argv: list[str]) -> int:
    if not argv:
        print(__doc__)
        return 0
    cmd = argv[0]
    if cmd == "status":
        return _status()
    if cmd == "audit":
        return _audit(int(argv[1]) if len(argv) > 1 and argv[1].isdigit() else 40)
    if cmd in ("advisor", "deadman"):
        return _advisor()
    if cmd == "rotate-token":
        return _rotate()
    if cmd == "operations":
        return _operations()
    if cmd == "verify-audit":
        return _verify_audit(False)
    if cmd == "export-audit":
        return _verify_audit(True)
    if cmd == "recovery":
        return _recovery()
    print(f"не знаю команду {cmd}\n{__doc__}")
    return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
