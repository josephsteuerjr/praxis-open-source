# Скопируй в .env и впиши значения.

# --- Модели: конфиг мозга живёт в memory/llm.json (плитка «Мозг» в пульте).
# .env больше НЕ хранит ключи моделей. Старые GLM_* переменные читаются один раз как
# миграционный сид (первый старт без llm.json) и после этого не нужны.

# --- Перцепционная петля (присутствие, не рефлекс) ---
PRAXIS_DEBOUNCE_SEC=4          # склейка всплеска: тишина перед проходом
PRAXIS_COOLDOWN_DM=8           # не чаще прохода в N сек в личке
PRAXIS_COOLDOWN_GROUP=180      # в группе — длиннее (присутствие без шума)
PRAXIS_LAST_N=80              # живой хвост первого прохода; дальше работает episode-memory
PRAXIS_PROMPT_CACHE=1          # cache_control на статике промпта (0 — фолбэк строкой)
PRAXIS_WEB_SEARCH=0            # hosted web search в голосе: z.ai или проверенный Codex relay
PRAXIS_OPENAI_NATIVE_WEB_SEARCH=0  # 1 только если OpenAI-compatible URL — наш relay с native search

# Кто говорит в консоли:
SPEAKER=Егор

# Private `PRAXIS_MAIL_BOT_TOKEN` и другие deploy-секреты держи в ОТДЕЛЬНОМ
# .deploy.env (см. README), не здесь. Public URL приложения настраивается ниже.

# --- MTProto (Praxis как пользователь @praxis_intelligence) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_2FA=
TELEGRAM_SESSION=praxis
TELEGRAM_ALLOWED_CHATS=

# --- Память v2 (эмбеддинги) ---
PRAXIS_EMBEDDINGS=0                  # 0 — без vectors (full-text + hosted rerank); 1 — legacy Ollama
OLLAMA_HOST=http://ollama:11434     # уже прокидывается в docker-compose
EMBED_MODEL=nomic-embed-text        # ollama pull nomic-embed-text (только при PRAXIS_EMBEDDINGS=1)
PRAXIS_SEMANTIC_RERANK=1            # explicit recall: hosted evaluator/Terra reranks full-text candidates
PRAXIS_LIMITS_URL=http://host.docker.internal:5012/v1/limits  # relay: фактические 5ч/недельное окна Codex
PRAXIS_LIMITS_TTL_SEC=60            # не опрашивать OpenAI чаще раза в минуту
# PRAXIS_EMBEDDINGS=hosted          # только если реально настроен OpenAI-compatible /embeddings endpoint
# PRAXIS_EMBED_BASE_URL=https://api.example/v1
# PRAXIS_EMBED_API_KEY=             # отдельный ключ; live Codex relay embeddings не обслуживает
# PRAXIS_EMBED_MODEL=text-embedding-3-small
PRAXIS_CONSOLIDATE_HOURS=24         # период «сна» в раннере; 0 — выключить
PRAXIS_COMPUTER_INVENTORY_HOURS=24  # карта Windows: догнать при первом часовом тике онлайн; 0 — выключить
PRAXIS_MEMORY_MAP_LIMIT=240          # максимум строк в каждой derived memory/maps/*.md
PRAXIS_MEMORY_INDEX_PEOPLE=12        # короткий people-preview в memory/INDEX.md
PRAXIS_HOT_LO=50                    # после обычного fold остаётся около 50 сообщений
PRAXIS_HOT_HI=100                   # у 100 ждём естественную границу эпизода
PRAXIS_HOT_HARD_HI=125              # если эпизод всё ещё открыт — явный continued-cut
PRAXIS_HOT_TOKEN_CAP=24000          # hard-cap оценки токенов, не финансовый лимит
PRAXIS_EPISODE_GAP_MIN=45           # пауза, считаемая естественной границей эпизода
PRAXIS_FORMATION_MAX_PASSES=4       # видимая дисциплина full ReflectionRun
PRAXIS_FORMATION_LIGHT_PASSES=1     # анти-мумия: harvest даже в light
PRAXIS_FORMATION_PATIENCE=2         # подряд проходов без поддержанных изменений до saturation
PRAXIS_CONTEXT_BUDGET=0             # 0 — не усекать собранный контекст кодовым потолком
PRAXIS_HISTORY_TURNS=100             # 20..500 model history turns; меняется конфигом, не кодом
PRAXIS_GROUP_ACK_MAX_LEN=0          # 0 — не фильтровать ACK/короткие сообщения до голоса
PRAXIS_ROOM_ENGAGEMENT=reflective   # addressed | reflective; default для полей без override
PRAXIS_ROOM_CONTEXT_HOT=200         # exact-topic сообщений в живом контексте (0..500)
PRAXIS_ROOM_CONTEXT_CHARS=24000     # topic/cross-topic orientation (1000..40000 символов)
PRAXIS_ROOM_CROSS_TOPICS=map        # off | map; карта и релевантные excerpts соседних топиков
PRAXIS_ROOM_BACKFILL_LIMIT=1500     # одноразовый канонический backfill комнаты (0..5000)
PRAXIS_SELF_DISTILL_DAYS=7          # только для явного legacy migration helper; ночной scheduler его не вызывает
PRAXIS_RECENCY_PENALTY=0.08         # насколько опускать давнее в выдаче recall (0 — не опускать)

# --- Sovereign shell (полный shell у Praxis-self и владельца) ---
PRAXIS_OWNER_ID=                    # Telegram id владельца (напр. 123456789)
PRAXIS_PANIC_IDS=                   # дополнительные numeric id со стоп-краном /panic; владелец всегда может
SHELL_TIMEOUT=30
# PRAXIS_WORKDIR=/app/workspace     # cwd для shell (по умолчанию ./workspace)
PRAXIS_CORE_EDIT_CHECK=1            # 1 — лёгкая модель-проверка перед правкой своего кода (fail-open); 0 — выкл
# --- boot-супервизор (краш-безопасное само-изменение) ---
PRAXIS_BOOT_GRACE=60               # сек: прожил дольше — коммит считается здоровым
PRAXIS_BOOT_MAX_FAILS=3            # ранних падений подряд до отката на здоровый коммит

# --- Controller к живому Windows execution body ---
# PRAXIS_BODY_BRIDGE_URL=http://praxis-bridge:9473  # production controller перейдёт на local UDS/private endpoint
# PRAXIS_BODY_CONTROLLER_TOKEN=                    # отдельный server-side token, не device credential
PRAXIS_BODY_DEVICE=windows-pc                      # target canonical Forge scope=windows
PRAXIS_MEDIA_DOCUMENT_MB=250                       # guarded outbound document; имя/MIME/размер проверяются до durable queue
PRAXIS_MEDIA_OUTBOX_RESULT_DAYS=30                 # terminal delivery receipts retention
PRAXIS_MEDIA_OUTBOX_RESULT_MAX=5000                # bounded newest terminal receipts; pending never pruned

# --- Комнаты и самостоятельные границы с незнакомцами ---
# TELEGRAM_ALLOWED_CHATS — базовый allowlist групп (через запятую); Praxis сама
# добавляет/убирает комнаты тулом manage_room в memory/rooms_allowlist.json.
# Дневного капа unknown нет: она отвечает естественно и сама вызывает freeze_contact при проблеме.

# --- Проактивность (единый durable social pulse) ---
PRAXIS_HEARTBEAT_HOURS=0            # legacy selector; clock его больше не планирует
PRAXIS_HEARTBEAT_MIN_AGE_DAYS=1     # нить «созревает» для вопроса не раньше N дней
PRAXIS_HEARTBEAT_MAX_AGE_DAYS=30    # слишком старые нити не воскрешаем
PRAXIS_SOCIAL_PULSE_HOURS=1         # каждый час осмотреть людей/follow-up; 0 — выключить
# Недавние доставки видны ей как receipts; код не задаёт target cooldown или daily cap.
PRAXIS_AUTO_RECALL_K=12             # сколько релевантных канонических фрагментов дать ходу; 1–64
PRAXIS_PRESENCE_SECTIONS=Мой характер сейчас|Моё авторство|Правда и воображение

# --- Непрерывность, иммунитет, inbox, сон ---
PRAXIS_MISSED_DM_HOURS=48          # boot-sweep: ЛС, оборванная рестартом, свежее N часов → проход с [missed]
# PRAXIS_MISSED_SWEEP_DELAY=25     # сек после подъёма до свипа (дать catch_up доиграть)
PRAXIS_IMMUNE_MAX_DIFF=400         # строк диффа: крупнее — технический рецензент оставляет warn
PRAXIS_IMMUNE_QUEUE_BATCH=3        # сколько self-коммитов разобрать за один тик
PRAXIS_IDENTITY_STATE_MIN_LOAD=0.1 # минимум для показа нагрузки в STATE; не permission gate
PRAXIS_IDENTITY_REVIEW_MIN_LOAD=0  # любое записанное событие можно осмыслить ночью
# PRAXIS_IMMUNE_MINUTES=15         # период разбора очереди самокоммитов (0 — выключить заботу)
PRAXIS_INBOX_FILE_MB=2048          # физический кап одного Telegram-документа
PRAXIS_INBOX_TOTAL_MB=10240        # общий дисковый потолок scoped inbox
PRAXIS_REM_MAX_TOKENS=2000         # бюджет РЕМ-фазы сна (гипотезы-ассоциации)

# --- Telegram audio: сильный local STT + женский neural TTS с local fallback ---
PRAXIS_STT_MODEL=/models/audio/whisper/faster-whisper-large-v3-turbo
PRAXIS_STT_REVISION=
PRAXIS_STT_COMPUTE_TYPE=int8
PRAXIS_STT_CPU_THREADS=2
PRAXIS_STT_BEAM_SIZE=5
PRAXIS_STT_LOCAL_FILES_ONLY=1
PRAXIS_STT_KEEP_LOADED=0       # 4GB-сервер: после voice освобождать ~2GB turbo-модели
PRAXIS_STT_MAX_BYTES=209715200
# Локальный shared STT выключен по умолчанию; deploy-compose включает только UDS-контур.
PRAXIS_STT_RPC_ENABLED=0
PRAXIS_STT_RPC_SOCKET=/run/praxis-stt/stt.sock
PRAXIS_STT_RPC_TOKEN_FILE=/run/secrets/praxis-stt-client.token
PRAXIS_STT_RPC_MAX_BYTES=15728640
PRAXIS_STT_RPC_RATE_PER_MINUTE=6
PRAXIS_STT_RPC_BURST=2
PRAXIS_STT_RPC_UPLOAD_TIMEOUT=30
PRAXIS_STT_RPC_TEMP_DIR=/run/praxis-stt-tmp
PRAXIS_TTS_BACKEND=edge
PRAXIS_EDGE_VOICE=ru-RU-SvetlanaNeural
PRAXIS_PIPER_MODEL=/models/audio/piper/ru_RU-irina-medium.onnx
# Основной tool-loop и автономный pulse не имеют скрытых поведенческих капов.

# --- Пульс по суткам, сон по будильнику, комнаты ---
PRAXIS_TZ=Europe/Moscow            # её локальные сутки (IANA); нет tzdata → фолбэк PRAXIS_TZ_OFFSET_H
# PRAXIS_TZ_OFFSET_H=3             # фиксированный сдвиг от UTC, если zoneinfo недоступен
PRAXIS_SLEEP_WINDOW=4-6            # окно сна (локальные часы); сон = >20ч от прошлого; догон >48ч — вне окна
# PRAXIS_SLEEP_CHECK_SEC=1800      # период проверки будильника сна (сон по sleep.json, не по секундомеру)
PRAXIS_BACKFILL_N=200              # новичок-протокол: сколько сообщений предыстории читать при входе в группу
# Старые drift/evaluator/window-cap поля удаляются при нормализации llm.json.
# роль family: правка people/<slug>.md владельцем (role: family) + id в known_ids; панель — PRAXIS_PANEL_GUEST_IDS

# --- Фаза выката формата снимка хода (memory/runs/**/context.md) ---
# ЧИТАЕТ ЭТОТ ФАЙЛ: служба praxis берёт только `env_file: .env`
# (docker-compose.deploy.yml:12), а agent.py зовёт load_dotenv(override=True) на
# импорте — значит рычаг подхватывается ПЕРЕЗАПУСКОМ РАННЕРА (мягкий выход 42),
# а не `docker restart`. В .deploy.env класть НЕЛЬЗЯ: его читают только
# mailroom_bot.py и serverapp.py.
# PRAXIS_SNAPSHOT_WRITE=v2         # v2 — писатель нового формата; умолчание/что угодно
#                                  # другое — вчерашний v1. Читатель понимает оба всегда.
# Проверка ДО перезапуска (ничего не перезапускает):
#   docker exec -w /app praxis python -c "import os;from dotenv import find_dotenv,load_dotenv;print(find_dotenv());load_dotenv(override=True);print(repr(os.environ.get('PRAXIS_SNAPSHOT_WRITE','v1').strip().lower()))"
# Выключить: убрать строку из .env и снова перезапустить раннер (memory/.control/restart_request.txt).
